<%- include('./partials/header') %>

<h2><%= method === 'PUT' ? 'Edit Journal' : 'New Journal' %></h2>

<form action="<%= action %>" method="POST">
  <% if (method === 'PUT') { %>
    <input type="hidden" name="_method" value="PUT">
  <% } %>

  <input type="text" name="destination" placeholder="Destination"
         value="<%= journal.destination || '' %>" <%= method==='PUT'?'readonly':'' %> required>

  <input type="date" name="arrivalDate"
         value="<%= journal.arrivalDate || '' %>" required>

  <input type="date" name="departureDate"
         value="<%= journal.departureDate || '' %>" required>

  <textarea name="experience" placeholder="Experience" required>
    <%= journal.experience || '' %>
  </textarea>

  <input type="number" name="rating" min="1" max="5"
         value="<%= journal.rating || '' %>" required>

  <button type="submit">
    <%= method === 'PUT' ? 'Update' : 'Create' %>
  </button>
</form>

<a href="/journals">Back</a>

<%- include('./partials/footer') %>
