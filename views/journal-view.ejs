<%- include('./partials/header') %>

<h2><%= journal.destination %></h2>

<p>Arrival: <%= journal.arrivalDate %></p>
<p>Departure: <%= journal.departureDate %></p>
<p>Rating: <%= journal.rating %></p>

<p><%= journal.experience %></p>

<a href="/journals">Back</a>
<a href="/journals/<%= journal.id %>/edit">Edit</a>

<form action="/journals/<%= journal.id %>?_method=DELETE" method="POST">
  <button type="submit">Delete</button>
</form>

<%- include('./partials/footer') %>
