<%- include('./partials/header') %>

<div class="row justify-content-center">
  <div class="col-md-8">
    <div class="card">
      <div class="card-body">
        <h2 class="card-title"><%= journal.destination %></h2>
        <hr>
        <div class="row mb-3">
          <div class="col-md-6">
            <p><strong>Arrival Date:</strong> <%= new Date(journal.arrivalDate).toLocaleDateString() %></p>
          </div>
          <div class="col-md-6">
            <p><strong>Departure Date:</strong> <%= new Date(journal.departureDate).toLocaleDateString() %></p>
          </div>
        </div>
        <div class="mb-3">
          <strong>Rating:</strong>
          <% for (let i = 0; i < 5; i++) { %>
            <span class="fs-4 text-<%= i < journal.rating ? 'warning' : 'muted' %>">&#9733;</span>
          <% } %>
        </div>
        <div class="mb-4">
          <strong>Experience:</strong>
          <p class="mt-2"><%= journal.experience %></p>
        </div>
        <hr>
        <div class="d-flex justify-content-between">
          <a href="/journals" class="btn btn-secondary">Back to Journals</a>
          <div>
            <a href="/journals/<%= journal.id %>/edit" class="btn btn-outline-primary">Edit</a>
            <form action="/journals/<%= journal.id %>?_method=DELETE" method="POST" class="d-inline"
                  onsubmit="return confirm('Are you sure you want to delete this journal?');">
              <button type="submit" class="btn btn-outline-danger">Delete</button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('./partials/footer') %>
