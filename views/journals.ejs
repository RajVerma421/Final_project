<%- include('./partials/header') %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h2>My Travel Journals</h2>
  <a href="/journal/new" class="btn btn-primary">New Journal</a>
</div>

<% if (journals.length === 0) { %>
  <div class="alert alert-info">No journals yet. Create your first travel journal!</div>
<% } else { %>
  <div class="row">
    <% journals.forEach(journal => { %>
      <div class="col-md-4 mb-4">
        <div class="card h-100">
          <div class="card-body">
            <h5 class="card-title"><%= journal.destination %></h5>
            <p class="card-text">
              <small class="text-muted">
                <%= new Date(journal.arrivalDate).toLocaleDateString() %> -
                <%= new Date(journal.departureDate).toLocaleDateString() %>
              </small>
            </p>
            <p class="card-text"><%= journal.experience.substring(0, 100) %>...</p>
            <div class="mb-2">
              <% for (let i = 0; i < 5; i++) { %>
                <span class="text-<%= i < journal.rating ? 'warning' : 'muted' %>">&#9733;</span>
              <% } %>
            </div>
            <a href="/journals/<%= journal.id %>" class="btn btn-sm btn-outline-primary">View</a>
            <a href="/journals/<%= journal.id %>/edit" class="btn btn-sm btn-outline-secondary">Edit</a>
          </div>
        </div>
      </div>
    <% }) %>
  </div>
<% } %>

<%- include('./partials/footer') %>
