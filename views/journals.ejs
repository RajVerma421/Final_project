<%- include('./partials/header') %>

<h2>My Journals</h2>

<a href="/journal/new">New Journal</a>

<% if (journals.length === 0) { %>
  <p>No journals yet</p>
<% } else { %>
  <% journals.forEach(journal => { %>
    <div>
      <h3><%= journal.destination %></h3>
      <p><%= journal.experience %></p>

      <a href="/journals/<%= journal.id %>">View</a>
      <a href="/journals/<%= journal.id %>/edit">Edit</a>
    </div>
  <% }) %>
<% } %>

<%- include('./partials/footer') %>
